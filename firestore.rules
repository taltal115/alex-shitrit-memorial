rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowlisted() {
      return signedIn() && request.auth.token.email == 'taltal115@gmail.com';
    }

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return allowlisted()
        || (signedIn()
          && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && roleData().role == 'super_admin');
    }

    function isAdmin() {
      return isSuperAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && roleData().role == 'content_manager');
    }

    match /prayerSections/{id} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /memorial/{id} {
      allow read: if true;
      allow create, update: if isSuperAdmin();
    }

    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin();
    }

    match /stories/{id} {
      allow read: if resource.data.approval_status == 'approved' || isAdmin();
      allow create: if signedIn()
        && request.resource.data.approval_status == 'pending'
        && request.resource.data.author_name is string;
      allow update, delete: if isAdmin();
    }
  }
}
