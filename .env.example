# Firebase web app config
# Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=alex-shitrit-memorial.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=alex-shitrit-memorial
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=alex-shitrit-memorial.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hebrew Date Configuration (verified after family confirmation)
# If BEFORE sunset: 9 Cheshvan 5781
# If AFTER sunset: 10 Cheshvan 5781
NEXT_PUBLIC_DEATH_DATE_HEBREW_DAY=9
NEXT_PUBLIC_DEATH_DATE_HEBREW_MONTH=Cheshvan
NEXT_PUBLIC_DEATH_DATE_HEBREW_YEAR=5781

# Cemetery Location for Halachic Times
NEXT_PUBLIC_CEMETERY_LATITUDE=31.7683
NEXT_PUBLIC_CEMETERY_LONGITUDE=35.2137
NEXT_PUBLIC_CEMETERY_TIMEZONE=Asia/Jerusalem
